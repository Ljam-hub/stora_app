# Django Settings
SECRET_KEY=dev-insecure-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (Leave unset for local SQLite default)
# DATABASE_URL=postgres://user:password@localhost:5432/stora

# Cloudinary (Media storage in production)
# CLOUDINARY_URL=cloudinary://KEY:SECRET@CLOUD_NAME

# Firebase Cloud Messaging (Modern HTTP v1 via Firebase Admin SDK)
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", ...}

# Gmail SMTP Email Configuration (for automatic password reset tokens)
# Note: Google requires an App Password from Google Account > Security > 2-Step Verification > App passwords
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_store_email@gmail.com
# EMAIL_HOST_PASSWORD=your_16_digit_app_password
# DEFAULT_FROM_EMAIL="STORA <your_store_email@gmail.com>"

