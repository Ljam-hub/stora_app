# ==========================================
# Root .gitignore for Stora Monorepo
# ==========================================

# Operating System & IDEs
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
ENV/
env/
**/venv/
**/.venv/

# Environment Variables & Secrets
.env
.env.*
!**/.env.example
*.pem
*.key
*firebase-adminsdk*.json
firebase-service-account.json

# Django & SQLite
db.sqlite3
db.sqlite3-journal
*.sqlite3
staticfiles/
media/

# Flutter & Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/

# Android
**/android/.gradle/
**/android/local.properties
**/android/app/debug
**/android/app/profile
**/android/app/release
**/android/key.properties
**/*.keystore
**/*.jks
**/*.apk
**/*.aab

# iOS / macOS
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.framework
**/ios/Flutter/.last_build_id
**/macos/Pods/
**/macos/Flutter/ephemeral/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
